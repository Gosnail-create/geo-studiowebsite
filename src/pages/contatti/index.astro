---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ModuloContatti from '../../components/ModuloContatti.astro';
import MappaSede from '../../components/MappaSede.astro';
import Testo from '../../components/Testo.astro';
import { azienda } from '../../data/sito';

const t = (await getEntry('speciali', 'contatti'))!.data;
const [ragione, indirizzo, tel, email, piva] = t.recapiti as string[];
const et = t.etichetteRecapiti;
// Hero senza immagine: il modulo segue subito (brief di revisione, punto 7).
---
<Base title={t.title} description={t.description}>
  <Hero titolo={t.h1} testo={[t.testo]} />

  <section class="section section--sunken contatti-sezione" aria-labelledby="modulo-titolo">
    <div class="container contatti">
      <div class="col-modulo">
        <ModuloContatti testi={t} />
      </div>
      <aside class="col-recapiti" aria-label={ragione}>
        <address class="recapiti on-brand">
          <p class="ragione">{ragione}</p>
          <dl>
            <div class="riga">
              <dt class="small">{et.telefono}</dt>
              <dd><a href={azienda.telefonoHref}>{tel.replace(/^Tel\. /, '')}</a></dd>
            </div>
            <div class="riga">
              <dt class="small">{et.email}</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div class="riga">
              <dt class="small">{et.sede}</dt>
              <dd>{indirizzo}</dd>
            </div>
          </dl>
          <p class="small">{piva}</p>
        </address>
        <MappaSede />
        <p class="candidature"><Testo text={t.candidature} /></p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contatti { display: grid; gap: var(--space-8); }
  @media (min-width: 1080px) {
    .contatti { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-8); align-items: start; }
    .col-modulo { grid-column: 1 / span 8; }
    .col-recapiti { grid-column: 9 / span 4; }
  }
  .col-recapiti { display: grid; gap: var(--space-6); }
  .recapiti { font-style: normal; border-radius: var(--radius-lg); padding: var(--space-8); display: grid; gap: var(--space-4); }
  .ragione { font-family: var(--font-head); font-size: var(--h3-size); line-height: var(--h3-line); font-weight: var(--h3-weight); }
  .recapiti dl { margin: 0; }
  .riga { display: grid; gap: var(--space-1); padding-block: var(--space-4); border-top: 1px solid var(--brand-2); }
  .riga:last-child { border-bottom: 1px solid var(--brand-2); }
  .riga dd {
    margin: 0; font-size: var(--body-size); line-height: var(--body-line); font-weight: var(--label-weight); color: var(--on-brand);
  }
  .riga dd a { text-decoration: none; }
  .riga dd a:hover { text-decoration: underline; }
  .candidature { padding-top: var(--space-6); border-top: 1px solid var(--line-strong); }
</style>

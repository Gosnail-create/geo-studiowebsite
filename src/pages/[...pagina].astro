---
// Pagine provvisorie della fase 1: ogni URL dell'alberatura esiste già,
// con un segnaposto dichiarato. Vengono sostituite fase dopo fase.
import Base from '../layouts/Base.astro';
import { alberatura } from '../data/alberatura';

export function getStaticPaths() {
  // URL già costruiti dalle pagine definitive.
  const PRONTE = (url: string) => url === '/' || url === '/chi-siamo/' || url.startsWith('/servizi/');
  return alberatura.filter((p) => !PRONTE(p.url)).map((p) => ({
    params: { pagina: p.url === '/' ? undefined : p.url.replace(/^\/|\/$/g, '') },
    props: { nome: p.nome },
  }));
}

const { nome } = Astro.props;
---
<Base title={`${nome} | Geo Studio Engineering`}>
  <section class="section">
    <div class="container provvisoria">
      <p class="label">Demo in costruzione</p>
      <h1 class="h1">{nome}</h1>
      <p class="segnaposto">Testo in preparazione</p>
    </div>
  </section>
</Base>

<style>
  .provvisoria { display: grid; gap: var(--space-4); padding-block: var(--space-8); }
  .segnaposto {
    padding: var(--space-6); background: var(--surface-sunken); border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg); color: var(--ink-muted);
  }
</style>

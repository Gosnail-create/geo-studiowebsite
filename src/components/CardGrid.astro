---
// Griglia di card: una colonna su mobile, due su tablet, fino a quattro su desktop.
interface Props {
  colonne?: 2 | 3 | 4;
}
const { colonne = 3 } = Astro.props;
---
<ul class:list={['card-grid', `col-${colonne}`]} role="list">
  <slot />
</ul>

<style>
  .card-grid { list-style: none; padding: 0; display: grid; gap: var(--space-6); grid-template-columns: minmax(0, 1fr); }
  .card-grid > :global(li) { display: flex; flex-direction: column; }
  @media (min-width: 640px) { .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) {
    .col-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .col-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>

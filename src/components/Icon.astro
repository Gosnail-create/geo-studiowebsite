---
// Icona Lucide inserita inline, con tratto 1,5 px (design-system/README.md, Iconografia).
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className = 'icon', label } = Astro.props;
const raw = readFileSync(resolve(process.cwd(), 'node_modules/lucide-static/icons', `${name}.svg`), 'utf8');
const inner = raw.replace(/<!--[\s\S]*?-->/, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>

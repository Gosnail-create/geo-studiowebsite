---
// Domande frequenti in accordion: elementi details/summary, utilizzabili da tastiera.
import Icon from './Icon.astro';

interface Props {
  titolo?: string;
  voci: { domanda: string; risposta: string }[];
  sfondo?: 'surface' | 'sunken';
}
const { titolo = 'Domande frequenti', voci, sfondo = 'surface' } = Astro.props;
---
<section class:list={['section', { 'section--sunken': sfondo === 'sunken' }]} aria-labelledby="faq-titolo">
  <div class="container faq">
    <h2 class="h2" id="faq-titolo">{titolo}</h2>
    <div class="voci">
      {voci.map((v) => (
        <details class="voce">
          <summary>
            <h3 class="domanda">{v.domanda}</h3>
            <Icon name="plus" class="icon segno piu" />
            <Icon name="minus" class="icon segno meno" />
          </summary>
          <p class="risposta">{v.risposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; gap: var(--space-8); }
  @media (min-width: 1080px) {
    .faq { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-6); }
    .faq > h2 { grid-column: 1 / span 4; }
    .voci { grid-column: 5 / span 8; }
  }
  .voci { border-top: 1px solid var(--line-strong); }
  .voce { border-bottom: 1px solid var(--line-strong); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding-block: var(--space-4); cursor: pointer; list-style: none; border-radius: var(--radius-sm);
  }
  summary::-webkit-details-marker { display: none; }
  .domanda { font-family: var(--font-head); font-size: var(--h3-size); line-height: var(--h3-line); font-weight: var(--h3-weight); color: var(--ink); }
  summary :global(.segno) { color: var(--brand); }
  summary :global(.meno), .voce[open] summary :global(.piu) { display: none; }
  .voce[open] summary :global(.meno) { display: block; }
  .risposta { padding-bottom: var(--space-6); color: var(--ink); max-width: var(--measure); }
</style>

---
// Card di un servizio (design-system/components/ServiceCard.html): numero in stile label,
// parallelogramma accent, titolo, testo e link. Piatta, su surface-raised.
import type { ImageMetadata } from 'astro';
import Figura from './Figura.astro';
import LinkFreccia from './LinkFreccia.astro';

interface Props {
  numero?: string;
  titolo: string;
  testo: string;
  href?: string;
  linkLabel?: string;
  immagine?: { src: ImageMetadata; alt: string; didascalia?: string };
  livello?: 'h2' | 'h3';
}
const { numero, titolo, testo, href, linkLabel = 'Approfondite', immagine, livello = 'h3' } = Astro.props;
const Titolo = livello;
---
<article class="card">
  {immagine && (
    <Figura src={immagine.src} alt={immagine.alt} didascalia={immagine.didascalia} ratio="16 / 9"
      widths={[480, 800]} sizes="(min-width: 1080px) 400px, 100vw" />
  )}
  {numero && (
    <div class="top">
      <span class="label">{numero}</span>
      <span class="cut-mark" aria-hidden="true"></span>
    </div>
  )}
  <Titolo class="h3">{titolo}</Titolo>
  <p class="testo">{testo}</p>
  {href && <LinkFreccia href={href} class="link">{linkLabel}<span class="visually-hidden">: {titolo}</span></LinkFreccia>}
</article>

<style>
  .card {
    background: var(--surface-raised); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); height: 100%;
  }
  @media (min-width: 768px) { .card { padding: var(--space-8); } }
  @media (min-width: 1080px) { .card { padding: var(--space-10); } }
  .top { display: flex; justify-content: space-between; align-items: center; padding-bottom: var(--space-3); border-bottom: 1px solid var(--line); }
  .testo { color: var(--ink-muted); }
  .card :global(.link) { margin-top: auto; align-self: flex-start; }
</style>

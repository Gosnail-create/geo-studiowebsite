---
// Ultima cella della griglia dei servizi (design-system/components/ServiceCard.md): card di contatto
// su brand, larga due colonne, con segno obliquo, titolo, frase e bottone che non va a capo.
import { cardContatto } from '../data/card-contatto';

interface Props {
  href: string;
}
const { href } = Astro.props;
---
<div class="card-contatto on-brand">
  <span class="cut-mark" aria-hidden="true"></span>
  <h3 class="h3">{cardContatto.titolo}</h3>
  <p class="frase">{cardContatto.testo}</p>
  <a class="btn btn-primary" href={href}>{cardContatto.bottone}</a>
</div>

<style>
  .card-contatto {
    border-radius: var(--radius-lg); padding: var(--space-8); height: 100%;
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: var(--space-3);
  }
  .frase { color: var(--on-brand-muted); }
  .card-contatto .btn { margin-top: var(--space-4); white-space: nowrap; }
</style>

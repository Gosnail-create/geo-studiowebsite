---
// Immagine con didascalia facoltativa, raggio radius-lg.
// Accetta un'immagine importata (rendering, ottimizzata da Astro) oppure una foto stock
// già ottimizzata in public/images.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Foto } from '../data/immagini';

interface Props {
  src?: ImageMetadata;
  foto?: Foto;
  alt?: string;
  didascalia?: string;
  widths?: number[];
  sizes?: string;
  ratio?: string;
  eager?: boolean;
}
const {
  src, foto, didascalia, ratio,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1080px) 600px, 100vw',
  eager = false,
} = Astro.props;
const alt = Astro.props.alt ?? foto?.alt ?? '';
const stile = ratio ? `aspect-ratio: ${ratio}` : undefined;
const srcset = foto?.larghezze.map((w) => `/images/${foto.nome}-${w}.webp ${w}w`).join(', ');
const altezza = foto ? Math.round((foto.height / foto.width) * foto.larghezze[foto.larghezze.length - 1]!) : 0;
---
<figure class="figura">
  {src && (
    <Image
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      style={stile}
    />
  )}
  {foto && (
    <img
      src={`/images/${foto.nome}-${foto.larghezze[1]}.webp`}
      srcset={srcset}
      sizes={sizes}
      width={foto.larghezze[foto.larghezze.length - 1]}
      height={altezza}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      style={stile}
    />
  )}
  {didascalia && <figcaption class="small">{didascalia}</figcaption>}
</figure>

<style>
  .figura { display: grid; gap: var(--space-2); }
  .figura :global(img) { width: 100%; height: auto; object-fit: cover; border-radius: var(--radius-lg); background: var(--sand); }
</style>

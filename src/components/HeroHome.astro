---
// Hero della home (design-system/components/Hero.md): split 7fr/5fr alto quanto serve al testo
// (space-16 sopra e sotto, almeno hero-min-h su desktop), foto a filo del bordo destro. Niente fascia di numeri né elementi decorativi fra
// testo e foto; il segno obliquo sta solo davanti all'etichetta.
import type { Foto } from '../data/immagini';
import LinkFreccia from './LinkFreccia.astro';
import { senzaVedova } from '../lib/vedova';

interface Props {
  etichetta?: string;
  titolo: string;
  testo: string[];
  bottone: { label: string; href: string };
  link?: { label: string; href: string };
  foto: Foto;
}
const { etichetta, titolo, testo, bottone, link, foto } = Astro.props;
const srcset = foto.larghezze.map((w) => `/images/${foto.nome}-${w}.webp ${w}w`).join(', ');
const largh = foto.larghezze[foto.larghezze.length - 1]!;
// La foto riempie l'altezza della hero con object-fit: cover, quindi la larghezza richiesta è
// l'altezza della hero per il rapporto della foto (circa 650px x 1,5 su desktop, 280px x 1,5 su
// mobile), non la larghezza della colonna: sizes lo dichiara perché il browser scelga la sorgente giusta.
const rapporto = foto.width / foto.height;
const sizes = `(min-width: 1080px) ${Math.round(660 * rapporto)}px, max(100vw, ${Math.round(280 * rapporto)}px)`;
---
<section class="hero-home" aria-labelledby="hero-titolo">
  <div class="hh-grid">
    <div class="hh-testo">
      {etichetta && <p class="label etichetta"><span class="cut-mark" aria-hidden="true"></span>{etichetta}</p>}
      <h1 class="display-xl" id="hero-titolo">{titolo}</h1>
      {testo.map((p) => <p class="lead misura">{senzaVedova(p)}</p>)}
      <div class="azioni">
        <a class="btn btn-primary btn-lg" href={bottone.href}>{bottone.label}</a>
        {link && <LinkFreccia href={link.href}>{link.label}</LinkFreccia>}
      </div>
    </div>
    <div class="hh-foto">
      <img src={`/images/${foto.nome}-1024.webp`} srcset={srcset} sizes={sizes}
        width={largh} height={Math.round((foto.height / foto.width) * largh)} alt={foto.alt}
        loading="eager" fetchpriority="high" decoding="async" />
    </div>
  </div>
</section>

<style>
  .hero-home { background: var(--surface); }
  .hh-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hh-foto { position: relative; order: -1; height: var(--hero-photo-h-mobile); }
  .hh-foto img { width: 100%; height: 100%; object-fit: cover; }
  .hh-testo {
    display: grid; gap: var(--space-4); justify-items: start; align-content: center;
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .etichetta { display: inline-flex; align-items: center; gap: var(--space-3); margin-bottom: calc(-1 * var(--space-1)); }
  .azioni { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-8); margin-top: var(--space-4); }
  @media (min-width: 768px) {
    .hh-testo { padding-inline: var(--space-8); }
  }

  /* desktop: il testo si allinea al contenitore, la foto arriva al bordo destro della finestra */
  @media (min-width: 1080px) {
    .hh-grid {
      min-height: var(--hero-min-h);
      grid-template-columns:
        minmax(var(--space-8), 1fr)
        minmax(0, calc(var(--content-max) * 7 / 12))
        minmax(0, calc(var(--content-max) * 5 / 12))
        minmax(var(--space-8), 1fr);
    }
    .hh-testo {
      grid-column: 2; padding: var(--space-16) var(--space-16) var(--space-16) 0;
    }
    .hh-foto { grid-column: 3 / -1; order: 0; height: auto; }
    .hh-foto img { position: absolute; inset: 0; border-bottom-left-radius: var(--radius-lg); }
  }

</style>

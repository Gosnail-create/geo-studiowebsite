---
// Banner dei cookie (testo da docs/testi-it.md). Nella demo la scelta si salva
// solo in localStorage e non attiva alcuno strumento: il sito non usa cookie statistici.
---
<section class="cookie" id="cookie-banner" aria-labelledby="cookie-titolo" hidden>
  <div class="container inner">
    <h2 class="visually-hidden" id="cookie-titolo">Preferenze sui cookie</h2>
    <p class="testo">
      Usiamo cookie tecnici, necessari al funzionamento del sito, e cookie statistici per capire in forma aggregata come viene usato, ma questi ultimi solo se ce lo consentite. Non usiamo cookie di profilazione.
      <a href="/cookie-policy/">Cookie policy</a>
    </p>

    <form class="pref" id="cookie-pref" hidden>
      <fieldset>
        <legend class="visually-hidden">Categorie di cookie</legend>
        <label class="check">
          <input type="checkbox" checked disabled />
          <span>Cookie tecnici</span>
        </label>
        <label class="check">
          <input type="checkbox" name="statistici" id="cookie-statistici" />
          <span>Cookie statistici</span>
        </label>
      </fieldset>
      <button class="btn btn-secondary btn-sm" type="submit">Salvate le preferenze</button>
    </form>

    <div class="azioni" id="cookie-azioni">
      <button class="btn btn-secondary btn-sm" type="button" data-scelta="accetta">Accettate</button>
      <button class="btn btn-secondary btn-sm" type="button" data-scelta="rifiuta">Rifiutate</button>
      <button class="btn btn-ghost btn-sm" type="button" aria-expanded="false" aria-controls="cookie-pref" data-scelta="personalizza">Personalizzate</button>
    </div>
  </div>
</section>

<script>
  const KEY = 'gs-cookie-consenso';
  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const pref = document.getElementById('cookie-pref') as HTMLFormElement;
  const stat = document.getElementById('cookie-statistici') as HTMLInputElement;
  const personalizza = banner.querySelector<HTMLButtonElement>('[data-scelta="personalizza"]')!;

  const leggi = (): { statistici: boolean } | null => {
    try {
      const v = localStorage.getItem(KEY);
      return v ? JSON.parse(v) : null;
    } catch {
      return null;
    }
  };

  const salva = (statistici: boolean) => {
    try {
      localStorage.setItem(KEY, JSON.stringify({ statistici, data: new Date().toISOString() }));
    } catch {
      /* archiviazione non disponibile: la scelta vale solo per questa visita */
    }
    banner.hidden = true;
    pref.hidden = true;
    personalizza.setAttribute('aria-expanded', 'false');
  };

  const mostra = (focus: boolean) => {
    const attuale = leggi();
    stat.checked = attuale?.statistici ?? false;
    banner.hidden = false;
    if (focus) banner.querySelector<HTMLElement>('button')?.focus();
  };

  if (!leggi()) mostra(false);

  banner.querySelector('[data-scelta="accetta"]')!.addEventListener('click', () => salva(true));
  banner.querySelector('[data-scelta="rifiuta"]')!.addEventListener('click', () => salva(false));
  personalizza.addEventListener('click', () => {
    const open = pref.hidden;
    pref.hidden = !open;
    personalizza.setAttribute('aria-expanded', String(open));
    if (open) stat.focus();
  });
  pref.addEventListener('submit', (e) => {
    e.preventDefault();
    salva(stat.checked);
  });

  document.querySelectorAll('[data-cookie-preferenze]').forEach((b) =>
    b.addEventListener('click', () => mostra(true)),
  );
</script>

<style>
  .cookie {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
    background: var(--surface-raised); border-top: 1px solid var(--line-strong);
  }
  .inner { display: grid; gap: var(--space-4); padding-block: var(--space-4); }
  .testo { font-size: var(--small-size); line-height: var(--small-line); color: var(--ink); }
  .testo a { margin-left: var(--space-1); }
  .azioni { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); align-items: center; }
  .pref { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
  .check { display: inline-flex; align-items: center; gap: var(--space-2); font-family: var(--ui-family); font-size: var(--ui-size); line-height: var(--ui-line); }
  .check input { width: var(--space-4); height: var(--space-4); accent-color: var(--brand); margin: 0; }
  @media (min-width: 1024px) {
    .inner { grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: var(--space-12); }
    .pref { grid-column: 1 / -1; grid-row: 2; }
  }
</style>

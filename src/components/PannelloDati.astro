---
// Pannello dati in acciaio (brand): valori in IBM Plex Mono e accent-on-brand, descrizioni in on-brand-muted.
import Testo from './Testo.astro';

interface Props {
  voci: { valore: string; descrizione: string }[];
  titolo?: string;
}
const { voci, titolo } = Astro.props;
---
<div class="pannello on-brand">
  {titolo && <p class="label">{titolo}</p>}
  <dl class="voci" style={`--colonne-md: ${Math.min(voci.length, 2)}`}>
    {voci.map((v) => (
      <div class="voce">
        <dt class="data-lg valore"><Testo text={v.valore} /></dt>
        <dd class="descrizione"><Testo text={v.descrizione} /></dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .pannello { border-radius: var(--radius-lg); padding: var(--space-6); display: grid; gap: var(--space-4); }
  .voci { display: grid; gap: var(--space-6); margin: 0; grid-template-columns: minmax(0, 1fr); }
  /* ogni valore in data-lg sta su una riga: al massimo due colonne, anche su desktop
     ("2 divisioni" a 32px non entra in un terzo della colonna di destra) */
  @media (min-width: 640px) { .voci { grid-template-columns: repeat(var(--colonne-md), minmax(0, 1fr)); } }
  .voce { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-3); border-top: 2px solid var(--accent-on-brand); }
  .valore { color: var(--accent-on-brand); }
  .descrizione { margin: 0; color: var(--on-brand-muted); }
  @media (min-width: 768px) { .pannello { padding: var(--space-8); } }
</style>

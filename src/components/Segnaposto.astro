---
// Blocco segnaposto dichiarato: contenuto atteso dal cliente o testo in preparazione.
interface Props {
  text?: string;
}
const { text = 'Testo in preparazione' } = Astro.props;
---
<div class="segnaposto" role="note">
  <span class="label">Segnaposto</span>
  <p>{text}</p>
</div>

<style>
  .segnaposto {
    display: grid; gap: var(--space-2); padding: var(--space-6);
    background: var(--surface-sunken); border: 1px dashed var(--line-strong); border-radius: var(--radius-lg);
  }
  .segnaposto p { color: var(--ink); }
</style>

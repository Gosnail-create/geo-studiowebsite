---
// Sezione di testo con H2. "split": titolo a sinistra e testo a destra fino al bordo del contenitore;
// "stack": titolo a tutta larghezza con il paragrafo d'apertura (intro) sotto, in lead su 8 colonne,
// poi il contenuto. Distanze (README, Forma, spazi e griglia): space-4 fra titolo e apertura,
// space-8 fra intestazione e contenuto, space-12 fra blocchi diversi, space-8 prima del link che
// chiude un elenco (classe .chiude).
import Testo from './Testo.astro';
import { senzaVedova } from '../lib/vedova';

interface Props {
  id?: string;
  etichetta?: string;
  titolo: string;
  testo?: string[];
  intro?: string;
  layout?: 'split' | 'stack';
  sfondo?: 'surface' | 'sunken';
}
const { id, etichetta, titolo, testo = [], intro, layout = 'split', sfondo = 'surface' } = Astro.props;
const headingId = id ? `${id}-titolo` : undefined;
---
<section id={id} class:list={['section', { 'section--sunken': sfondo === 'sunken' }]} aria-labelledby={headingId}>
  <div class:list={['container', 'sez', `sez--${layout}`]}>
    <div class="sez-head">
      {etichetta && <p class="label">{etichetta}</p>}
      <h2 class="h2" id={headingId}>{titolo}</h2>
      {intro && <p class="lead intro"><Testo text={senzaVedova(intro)} /></p>}
      {Astro.slots.has('aside') && <div class="sez-aside"><slot name="aside" /></div>}
    </div>
    <div class="sez-body prose">
      {testo.map((p) => <p><Testo text={p} /></p>)}
      <slot />
    </div>
    {Astro.slots.has('full') && <div class="sez-full"><slot name="full" /></div>}
  </div>
</section>

<style>
  .sez { display: grid; row-gap: var(--space-8); column-gap: var(--space-6); grid-template-columns: minmax(0, 1fr); }
  .sez-head { display: grid; gap: var(--space-4); align-content: start; }
  .sez-head .label { margin-bottom: calc(-1 * var(--space-2)); }
  .intro { color: var(--ink); text-wrap: balance; }
  .sez-aside { margin-top: var(--space-4); }
  .sez-full { margin-top: 0; }
  /* sotto i 1080px le due colonne si impilano: il testo torna entro measure */
  @media (max-width: 1079px) {
    .sez--split .sez-body, .intro { max-width: var(--measure); }
  }
  /* blocchi diversi a space-12, paragrafi consecutivi a space-4, link di chiusura a space-8 */
  .sez-body > :global(* + *) { margin-top: var(--space-12); }
  .sez-body > :global(p + p) { margin-top: var(--space-4); }
  .sez-body > :global(p + :is(.passi, .elenco)) { margin-top: var(--space-8); }
  .sez-body > :global(.chiude) { margin-top: var(--space-8); }
  @media (min-width: 1080px) {
    .sez { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    /* titolo su 5 colonne, contenuto su 7 fino al bordo destro (circa 75 caratteri in body-lg) */
    .sez--split .sez-head { grid-column: 1 / span 5; }
    .sez--split .sez-body { grid-column: 6 / span 7; }
    .sez--stack .sez-head { grid-column: 1 / span 8; }
    .sez--stack .sez-body { grid-column: 1 / -1; }
    .sez-full { grid-column: 1 / -1; }
  }
</style>

---
import { Image } from 'astro:assets';
import logoNegativo from '../../assets/logo/geostudio-logo-negativo.png';
import { servizi } from '../data/servizi';
import { azienda, linkStudio } from '../data/sito';
---
<footer class="site-footer on-deep">
  <div class="container">
    <div class="cols">
      <div class="col col-azienda">
        <Image src={logoNegativo} alt="Geo Studio Engineering" height={56} densities={[1, 2]} />
        <p class="azienda">{azienda.ragioneSociale}, {azienda.descrizione}, {azienda.indirizzo}</p>
      </div>

      <nav class="col" aria-labelledby="footer-servizi">
        <h2 class="label" id="footer-servizi"><a href="/servizi/">Servizi</a></h2>
        <ul>
          {servizi.map((s) => <li><a href={s.url}>{s.nome}</a></li>)}
        </ul>
      </nav>

      <nav class="col" aria-labelledby="footer-studio">
        <h2 class="label" id="footer-studio">Geo Studio</h2>
        <ul>
          {linkStudio.map((l) => <li><a href={l.url}>{l.nome}</a></li>)}
        </ul>
      </nav>

      <div class="col">
        <h2 class="label">Recapiti</h2>
        <ul>
          <li>Tel. <a href={azienda.telefonoHref}>{azienda.telefono}</a></li>
          <li><a href={`mailto:${azienda.email}`}>{azienda.email}</a></li>
          {azienda.social.map((s) => <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.nome}<span class="visually-hidden"> (si apre in una nuova scheda)</span></a></li>)}
        </ul>
      </div>
    </div>

    <div class="legal small">
      <p>© 2026 {azienda.ragioneSociale}</p>
      <p>P. IVA e C.F. {azienda.piva}</p>
      <ul>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/cookie-policy/">Cookie policy</a></li>
        <li><button type="button" class="link-button" data-cookie-preferenze>Preferenze cookie</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-16) var(--space-8); margin-top: auto; }
  .cols { display: grid; gap: var(--space-8); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .cols { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-6); }
    .col { grid-column: span 3; }
  }
  .col-azienda :global(img) { height: var(--space-12); width: auto; margin-bottom: var(--space-4); }
  .col h2 { margin-bottom: var(--space-3); }
  .col h2 a { color: inherit; text-decoration: none; }
  .col ul { list-style: none; padding: 0; }
  .col li + li { margin-top: var(--space-2); }
  .col a { text-decoration: none; }
  .col a:hover, .legal a:hover { text-decoration: underline; }
  .legal {
    display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); align-items: center;
    margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--brand-deep-2);
  }
  .legal ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); list-style: none; padding: 0; }
  .link-button {
    font: inherit; color: var(--on-brand-deep); background: none; border: 0; padding: 0; cursor: pointer;
    text-decoration: underline; text-underline-offset: 0.2em;
  }
  .legal a { color: var(--on-brand-deep); }
</style>

---
// Riga del blog (design-system/components/BlogRow.md): copertina, metadati, titolo, riassunto e
// link. Varianti: "evidenza" (articolo più recente), "riga" (pagina /blog/), "compatta" (home).
// Tutta la riga è cliccabile attraverso il link del titolo; "Leggete l'articolo" è solo visivo.
import { Image } from 'astro:assets';
import type { Articolo } from '../data/blog';
import { foto as fotoStock, type NomeFoto } from '../data/immagini';
import { rendering } from '../data/rendering';
import Icon from './Icon.astro';
import Testo from './Testo.astro';

interface Props {
  articolo: Articolo;
  aggiornato: string;
  variante?: 'evidenza' | 'riga' | 'compatta';
  livello?: 'h2' | 'h3';
}
const { articolo, aggiornato, variante = 'riga', livello = 'h2' } = Astro.props;
const Titolo = livello;
const foto = articolo.foto ? fotoStock(articolo.foto as NomeFoto) : undefined;
const render = articolo.rendering ? rendering[articolo.rendering] : undefined;
const sizes = variante === 'evidenza' ? '(min-width: 1080px) 700px, 100vw' : '(min-width: 1080px) 400px, 100vw';
---
<article class:list={['blog-row', variante, { 'con-link': articolo.href }]} data-area={articolo.area}>
  <div class="media-box">
    {foto && (
      <img class="media" src={`/images/${foto.nome}-1024.webp`}
        srcset={foto.larghezze.map((w) => `/images/${foto.nome}-${w}.webp ${w}w`).join(', ')} sizes={sizes}
        width="1024" height={Math.round((1024 * foto.height) / foto.width)} alt={foto.alt} loading="lazy" decoding="async" />
    )}
    {render && <Image class="media" src={render.src} alt={render.alt} widths={[640, 1024, 1600]} sizes={sizes} />}
  </div>
  <div class="txt">
    <div class="meta">
      <span class="label">{articolo.area}</span>
      <span class="small"><Testo text={aggiornato} /></span>
      <span class="tag">Bozza</span>
    </div>
    <Titolo class={variante === 'evidenza' ? 'title-md titolo' : 'h3 titolo'}>
      {articolo.href ? <a class="titolo-link" href={articolo.href}>{articolo.titolo}</a> : articolo.titolo}
    </Titolo>
    <p class:list={['riassunto', variante === 'evidenza' ? 'lead' : 'body']}>{articolo.riassunto}</p>
    {articolo.href && (
      <span class="btn btn-ghost leggi" aria-hidden="true">Leggete l'articolo<Icon name="arrow-right" class="icon icon-sm" /></span>
    )}
  </div>
</article>

<style>
  .blog-row { position: relative; display: grid; gap: var(--space-6); grid-template-columns: minmax(0, 1fr); }
  .media-box { overflow: hidden; border-radius: var(--radius-lg); aspect-ratio: 16 / 9; }
  .blog-row :global(.media) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform var(--duration-photo) var(--ease-out-soft);
  }
  .txt { display: grid; gap: var(--space-3); align-content: start; justify-items: start; }
  .meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); }
  .tag {
    font-family: var(--label-family); font-size: var(--label-size); line-height: var(--label-line); font-weight: var(--label-weight);
    color: var(--ink); border: 1.5px solid var(--line-strong); border-radius: var(--radius-md); padding: 0 var(--space-2);
  }
  .titolo-link { color: var(--ink); text-decoration: none; }
  /* il link del titolo si allarga sull'intera riga */
  .titolo-link::after { content: ""; position: absolute; inset: 0; }
  .riassunto { color: var(--ink); }
  .riga .riassunto, .compatta .riassunto {
    display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; -webkit-line-clamp: 3; line-clamp: 3;
  }
  .compatta .riassunto { -webkit-line-clamp: 2; line-clamp: 2; }
  .riga .riassunto { max-width: var(--measure); }
  .leggi { pointer-events: none; }

  @media (hover: hover) {
    .con-link:hover .titolo-link { text-decoration: underline; text-decoration-color: var(--accent-ink); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .con-link:hover :global(.media) { transform: scale(1.04); }
    .con-link:hover .leggi :global(.icon) { transform: translateX(var(--space-1)); }
  }
  .titolo-link:focus-visible { outline: none; }
  .con-link:has(.titolo-link:focus-visible) { outline: 2px solid var(--focus); outline-offset: var(--space-2); border-radius: var(--radius-lg); }

  /* da 768px la foto sta accanto al testo; l'articolo in evidenza, con titolo e riassunto più grandi,
     la affianca da 1080px, prima resta sopra a tutta larghezza */
  @media (min-width: 1080px) {
    .evidenza { grid-template-columns: 7fr 5fr; column-gap: var(--space-12); align-items: center; }
  }
  @media (min-width: 768px) {
    .riga { grid-template-columns: 4fr 8fr; column-gap: var(--space-10); align-items: start; }
    .compatta { grid-template-columns: 3fr 9fr; column-gap: var(--space-8); align-items: start; }
    .riga .media-box, .compatta .media-box { aspect-ratio: 3 / 2; }
  }
</style>
